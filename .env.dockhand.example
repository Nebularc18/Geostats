# Paste these into Dockhand's environment editor.
# Replace the public URLs with the final Dockhand or reverse-proxy URLs before building.
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=https://geostats.example.com
API_ORIGIN=https://geostats-api.example.com
NEXT_PUBLIC_API_URL=https://geostats-api.example.com

POSTGRES_USER=geostats
POSTGRES_PASSWORD=change-this-postgres-password-min-32-chars
POSTGRES_DB=geostats
# The password in this URL must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://geostats:change-this-postgres-password-min-32-chars@postgres:5432/geostats?schema=public

REDIS_PASSWORD=change-this-redis-password-min-32-chars

MINIO_ROOT_USER=geostatsminio
MINIO_ROOT_PASSWORD=change-this-minio-password-min-32-chars
S3_REGION=us-east-1
S3_BUCKET=geostats-imports

JWT_SECRET=change-this-jwt-secret-minimum-32-chars
COLLECTOR_TOKEN_ENCRYPTION_KEY=change-this-collector-token-key-32-chars

AUTH_MODE=password
NEXT_PUBLIC_AUTH_MODE=password
NEXT_PUBLIC_AUTH_PROVIDER_NAME=Home Auth
DEV_AUTH_EMAIL=dev@local.geostats
DEV_AUTH_USERNAME=dev

# Leave these blank unless AUTH_MODE=external.
EXTERNAL_AUTH_PROVIDER_ID=home-auth
EXTERNAL_AUTH_CLIENT_ID=
EXTERNAL_AUTH_CLIENT_SECRET=
EXTERNAL_AUTH_REQUIRE_VERIFIED_EMAIL=false
EXTERNAL_AUTH_AUTHORIZE_URL=
EXTERNAL_AUTH_TOKEN_URL=
EXTERNAL_AUTH_USERINFO_URL=
EXTERNAL_AUTH_CALLBACK_URL=https://geostats-api.example.com/auth/external/callback
# Optional: post directly to a provider login route when the OIDC sign-in page does not resume returnTo.
EXTERNAL_AUTH_DIRECT_LOGIN_URL=

UPLOAD_MAX_BYTES=52428800
IMPORT_WORKER_CONCURRENCY=2

# For Git deployments that build from this repo, these defaults tag local images.
# To deploy prebuilt GHCR images, set GEOSTATS_IMAGE_PREFIX=ghcr.io/owner/repo and GEOSTATS_IMAGE_TAG=<tag>.
GEOSTATS_IMAGE_PREFIX=geostats
GEOSTATS_IMAGE_TAG=dockhand
