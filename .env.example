NODE_ENV=development

DATABASE_URL=postgresql://geostats:replace-with-a-strong-postgres-password@postgres:5432/geostats?schema=public
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=geostats-imports
S3_ACCESS_KEY_ID=replace-with-a-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-secret
S3_FORCE_PATH_STYLE=true

JWT_SECRET=replace-with-at-least-32-random-bytes
COLLECTOR_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-byte-collector-token-key
API_ORIGIN=http://localhost:3001
# GSAK 9's HTTP component ignores non-standard ports. This dedicated origin
# reaches the restricted port-80 gateway; normal app/API traffic still uses API_ORIGIN.
GSAK_IMPORT_ORIGIN=http://localhost
GSAK_PORT=80
WEB_ORIGIN=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_MODE=clerk
# Use keys from the Clerk application owned by this installation.
CLERK_SECRET_KEY=
# Public key returned to mobile clients. Use the same Clerk application as above.
CLERK_PUBLISHABLE_KEY=
# Optional: use the instance's public JWT key to verify tokens without JWKS discovery.
CLERK_JWT_KEY=
# Comma-separated web origins allowed in Clerk's azp claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
DEV_AUTH_EMAIL=dev@local.geostats
DEV_AUTH_USERNAME=dev
DEV_AUTH_CREATE_PROFILE=true
DEV_AUTH_GC_USERNAME=dev
DEV_AUTH_TIME_ZONE=Europe/Stockholm
NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_AUTH_PROVIDER_NAME=Clerk
# This must come from the same Clerk application as CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEV_AUTO_LOGIN=false
API_PORT=3001
# Keep this on loopback when the reverse proxy runs locally. Use 0.0.0.0 when
# a trusted reverse proxy or Cloudflare Tunnel reaches the API over the LAN.
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:${API_PORT:-3001}
UPLOAD_MAX_BYTES=52428800
PORTABILITY_MAX_BYTES=52428800

MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-secret
POSTGRES_USER=geostats
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=geostats
