# Local disposable agent/dev defaults.
# Do not use this file's secrets for an internet-facing deployment.
NODE_ENV=development

WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

POSTGRES_USER=geostats
POSTGRES_PASSWORD=geostats-local-postgres-password-32chars
POSTGRES_DB=geostats
DATABASE_URL=postgresql://geostats:geostats-local-postgres-password-32chars@postgres:5432/geostats?schema=public

REDIS_PASSWORD=geostats-local-redis-password-32chars
REDIS_URL=redis://:geostats-local-redis-password-32chars@redis:6379

MINIO_ROOT_USER=geostatsminio
MINIO_ROOT_PASSWORD=geostats-local-minio-password-32chars
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=geostats-imports
S3_ACCESS_KEY_ID=geostatsminio
S3_SECRET_ACCESS_KEY=geostats-local-minio-password-32chars
S3_FORCE_PATH_STYLE=true

JWT_SECRET=geostats-local-jwt-secret-minimum-32-characters
COLLECTOR_TOKEN_ENCRYPTION_KEY=geostats-local-collector-key-32-chars

AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_PROVIDER_NAME=Dev Auth
NEXT_PUBLIC_DEV_AUTO_LOGIN=true
DEV_AUTH_EMAIL=dev@local.geostats
DEV_AUTH_USERNAME=dev
DEV_AUTH_CREATE_PROFILE=true
DEV_AUTH_GC_USERNAME=dev
DEV_AUTH_TIME_ZONE=Europe/Stockholm

# External auth is intentionally disabled in agent/dev mode.
EXTERNAL_AUTH_PROVIDER_ID=home-auth
EXTERNAL_AUTH_CLIENT_ID=
EXTERNAL_AUTH_CLIENT_SECRET=
EXTERNAL_AUTH_REQUIRE_VERIFIED_EMAIL=false
EXTERNAL_AUTH_AUTHORIZE_URL=
EXTERNAL_AUTH_TOKEN_URL=
EXTERNAL_AUTH_USERINFO_URL=
EXTERNAL_AUTH_CALLBACK_URL=http://localhost:3001/auth/external/callback
EXTERNAL_AUTH_DIRECT_LOGIN_URL=

UPLOAD_MAX_BYTES=52428800
IMPORT_WORKER_CONCURRENCY=2

GEOSTATS_IMAGE_PREFIX=geostats
GEOSTATS_IMAGE_TAG=agent
