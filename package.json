{
  "name": "geostats",
  "version": "0.1.0",
  "main": "apps/mobile/index.ts",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@geostats/shared": "workspace:*",
    "expo": "~56.0.12",
    "expo-clipboard": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-linking": "~56.0.14",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.24",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "^5.7.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm -r --parallel dev",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "format": "prettier --write .",
    "agent:up": "powershell -ExecutionPolicy Bypass -File scripts/agent-up.ps1",
    "mobile:start": "corepack pnpm --filter @geostats/mobile start",
    "mobile:android": "corepack pnpm --filter @geostats/mobile android",
    "mobile:build:apk": "corepack pnpm dlx eas-cli build --platform android --profile preview",
    "mobile:build:aab": "corepack pnpm dlx eas-cli build --platform android --profile production",
    "mobile:update:preview": "corepack pnpm --filter @geostats/shared build && corepack pnpm dlx eas-cli update --channel preview --auto",
    "mobile:update:production": "corepack pnpm --filter @geostats/shared build && corepack pnpm dlx eas-cli update --channel production --auto",
    "eas-build-post-install": "corepack pnpm --filter @geostats/shared build",
    "collect-owner-logs": "corepack pnpm --filter @geostats/tools collect-owner-logs",
    "db:generate": "corepack pnpm --filter @geostats/db db:generate",
    "db:migrate": "corepack pnpm --filter @geostats/db db:migrate",
    "db:seed": "corepack pnpm --filter @geostats/db db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~6.0.3"
  }
}
