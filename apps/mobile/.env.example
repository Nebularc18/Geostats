# The selected Geostats server provides its Clerk publishable key via /auth/config.
EXPO_PUBLIC_API_URL=https://api.example.com
# Public web origin used for shareable challenge result links (/challenge/:username/:gcCode).
# Optional: when unset, mobile derives it from the API URL (-api. subdomain removed, :3001 -> :3000 in dev).
EXPO_PUBLIC_WEB_URL=https://geostats.example.com
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-api-key
