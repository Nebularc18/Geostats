{
  "name": "@geostats/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@geostats/db": "workspace:*",
    "@geostats/gpx-parser": "workspace:*",
    "@geostats/shared": "workspace:*",
    "@geostats/stats": "workspace:*",
    "bullmq": "^5.34.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
